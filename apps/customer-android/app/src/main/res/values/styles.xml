<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF78AE</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101013</item>
        <item name="android:navigationBarColor">#101013</item>
        <item name="android:textColorPrimary">#F7F5F7</item>
        <item name="android:textColorSecondary">#B9B6C2</item>
        <item name="android:colorBackground">#1C1C22</item>
        <item name="android:alertDialogTheme">@style/PanelDialog</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#101013</item>
    </style>
    <style name="PanelDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FF78AE</item>
        <item name="android:colorBackground">#1C1C22</item>
        <item name="android:textColorPrimary">#F7F5F7</item>
        <item name="android:textColorSecondary">#B9B6C2</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
