[Unit]
Description=VIP GECE change-only IndexNow URL notification
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/www/vip-gece-site/current/package.json
ConditionPathExists=/var/www/vip-gece-site/current/.env

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/vip-gece-site/current
Environment=NODE_ENV=production
Environment=VIP_GECE_INDEXNOW_STATE_PATH=/var/lib/vip-gece/indexnow-state.json
Environment=VIP_GECE_INDEXNOW_REPORT_PATH=/var/lib/vip-gece/indexnow-latest.json
ExecStart=/usr/bin/npm run indexnow-submit
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/vip-gece

[Install]
WantedBy=multi-user.target
